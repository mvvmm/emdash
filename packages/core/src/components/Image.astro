---
/**
 * Portable Text Image block component
 *
 * Renders image blocks from WordPress imports and EmDash media.
 * Uses the provider's getSrc function for responsive srcset generation.
 */
import { Image as AstroImage, getImage } from "astro:assets";
import type { ImageEmbed } from "../media/types.js";
import { getMediaProvider } from "../media/provider-loader.js";
import { buildRenderMediaUrl } from "../media/url.js";
import {
	canOptimizeImage,
	toAbsoluteMediaUrl,
	responsiveWidths,
} from "../media/responsive.js";
import { getPublicOrigin } from "../api/public-url.js";
import { sanitizeHref } from "../utils/url.js";
import { normalizeImageLink } from "../content/converters/image-link.js";
import { resolveImageMedia } from "../content/converters/gallery.js";
import { sanitizeImageDarkVariant } from "../content/converters/image-dark-variant.js";
import type { PortableTextImageDarkVariant } from "../content/converters/types.js";

export interface Props {
	node: {
		_type: "image";
		_key: string;
		asset: {
			_ref: string;
			url?: string;
			/** Provider ID for external media (e.g., "cloudflare-images") */
			provider?: string;
			/** Provider metadata. LQIP is read from first-class fields below;
			 *  `meta` only remains as a fallback for legacy snapshots. */
			meta?: Record<string, unknown>;
		};
		alt?: string;
		caption?: string;
		title?: string;
		/** Original image width */
		width?: number;
		/** Original image height */
		height?: number;
		/** LQIP blurhash — first-class field (legacy snapshots store it in `asset.meta`). */
		blurhash?: string;
		/** LQIP dominant color — first-class field (legacy snapshots store it in `asset.meta`). */
		dominantColor?: string;
		/** Display width for this instance (overrides original) */
		displayWidth?: number;
		/** Display height for this instance (overrides original) */
		displayHeight?: number;
		/** Alignment for this image instance (e.g. from a WordPress import) */
		alignment?: "left" | "center" | "right" | "wide" | "full";
		/**
		 * Optional link. When set, the image is rendered inside an `<a>` using
		 * `sanitizeHref`-validated `href`. A bare string is the legacy shape
		 * written by WordPress/Gutenberg imports.
		 */
		link?: string | { href: string; blank?: boolean };
		/** Image shown instead of this one in a dark color scheme. */
		darkVariant?: PortableTextImageDarkVariant;
	};
	/** Render the LQIP placeholder as an inline background. Disable for strict CSP. */
	placeholder?: boolean;
}

/**
 * Generate srcset using provider's getSrc function
 */
function generateSrcset(
	getSrc: NonNullable<ImageEmbed["getSrc"]>,
	maxWidth: number,
	aspectRatio?: number,
	originalWidth?: number,
): string {
	return responsiveWidths(maxWidth, originalWidth)
		.map((w) => {
			const h = aspectRatio ? Math.round(w / aspectRatio) : undefined;
			return `${getSrc({ width: w, height: h })} ${w}w`;
		})
		.join(", ");
}

const { node, placeholder = true } = Astro.props;

if (!node?.asset) {
	return null;
}

const { caption, title, displayWidth, displayHeight, alignment, link } = node;
const { asset, alt = "", width, height } = resolveImageMedia(node);
const dimension = (value: number | undefined) =>
	typeof value === "number" && Number.isFinite(value) && value > 0 ? value : undefined;
const customWidth = dimension(displayWidth);
const customHeight = dimension(displayHeight);

const imageLink = normalizeImageLink(link);
const linkHref = imageLink ? sanitizeHref(imageLink.href) : null;
// Same-page anchor links (`#section`) are on-page jumps — never open them in
// a new tab, regardless of `blank`. Mirrors marks/Link.astro.
const isSamePageAnchor = linkHref?.startsWith("#") ?? false;
const linkBlank = !isSamePageAnchor && imageLink?.blank === true;
const linkTarget = linkBlank ? "_blank" : undefined;
const linkRel = linkBlank ? "noopener noreferrer" : undefined;

interface ImageSource {
	asset: { _ref: string; url?: string; provider?: string };
	width?: number;
	height?: number;
	blurhash?: string;
	dominantColor?: string;
}

interface ResolvedImage {
	src: string;
	srcset?: string;
	sizes?: string;
	astroImageSrc: string;
	renderWidth?: number;
	renderHeight?: number;
	placeholderStyle: string;
}

/**
 * Resolve the source URL, srcset, render size, and LQIP style for one image.
 * The node's display size applies to every image it shows.
 */
async function resolveImage(image: ImageSource): Promise<ResolvedImage> {
	const originalWidth = dimension(image.width);
	const originalHeight = dimension(image.height);

	// Calculate aspect ratio from original dimensions
	const aspectRatio = originalWidth && originalHeight ? originalWidth / originalHeight : undefined;

	// Calculate render dimensions
	let renderWidth: number | undefined;
	let renderHeight: number | undefined;

	if (customWidth && customHeight) {
		renderWidth = customWidth;
		renderHeight = customHeight;
	} else if (customWidth && aspectRatio) {
		renderWidth = customWidth;
		renderHeight = Math.round(customWidth / aspectRatio);
	} else if (customHeight && aspectRatio) {
		renderWidth = Math.round(customHeight * aspectRatio);
		renderHeight = customHeight;
	} else {
		renderWidth = originalWidth;
		renderHeight = originalHeight;
	}

	// Get the image source URL and srcset
	let src = "";
	let srcset: string | undefined;
	let sizes: string | undefined;
	let astroImageSrc = "";
	const providerId = image.asset.provider;

	if (providerId && providerId !== "local") {
		// External provider
		const provider = await getMediaProvider(providerId);
		if (provider) {
			try {
				const mediaValue = {
					provider: providerId,
					id: image.asset._ref,
					width: renderWidth,
					height: renderHeight,
					alt,
				};
				const result = provider.getEmbed(mediaValue, {
					width: renderWidth,
					height: renderHeight,
				});
				const embed = result instanceof Promise ? await result : result;
				if (embed.type === "image") {
					src = embed.src;

					// Generate srcset if provider supports dynamic sizing
					if (embed.getSrc) {
						const maxWidth = renderWidth || 1200;
						const ar = renderWidth && renderHeight ? renderWidth / renderHeight : aspectRatio;
						srcset = generateSrcset(embed.getSrc, maxWidth, ar, originalWidth);
						sizes = renderWidth
							? `(min-width: ${renderWidth}px) ${renderWidth}px, 100vw`
							: "100vw";
					}
				}
			} catch (error) {
				console.warn(`Failed to get embed for image ${image.asset._ref}:`, error);
			}
		}
	}

	// Fallback for local provider. `asset.url` carries the storage key with
	// extension when present; `asset._ref` is a bare ULID that only the internal
	// `/file/{id}` route can resolve. `buildRenderMediaUrl` picks the right shape.
	if (!src) {
		src = buildRenderMediaUrl(Astro.locals.emdash?.getPublicMediaUrl, {
			url: image.asset.url,
			id: image.asset._ref,
		});
		if (renderWidth && renderHeight) {
			const absoluteSrc = toAbsoluteMediaUrl(
				src,
				getPublicOrigin(Astro.url, Astro.locals.emdash?.config),
			);
			if (
				await canOptimizeImage(getImage, {
					src: absoluteSrc,
					width: renderWidth,
					height: renderHeight,
				})
			) {
				astroImageSrc = absoluteSrc;
			}
		}
	}

	let placeholderStyle = "";
	if (placeholder && image.blurhash) {
		const { blurhashToImageCssString } = await import("@unpic/placeholder");
		placeholderStyle = blurhashToImageCssString(image.blurhash);
	} else if (placeholder && image.dominantColor) {
		placeholderStyle = `background-color: ${image.dominantColor};`;
	}

	return { src, srcset, sizes, astroImageSrc, renderWidth, renderHeight, placeholderStyle };
}

// Prefer first-class LQIP fields; fall back to `asset.meta` for legacy
// snapshots persisted before LQIP was promoted.
const resolved = await resolveImage({
	asset,
	width,
	height,
	blurhash: node.blurhash ?? (node.asset.meta?.blurhash as string | undefined),
	dominantColor: node.dominantColor ?? (node.asset.meta?.dominantColor as string | undefined),
});
const darkVariant = sanitizeImageDarkVariant(node.darkVariant);
const resolvedDark = darkVariant
	? await resolveImage(darkVariant)
	: null;

const variants = [
	{ image: resolved, class: resolvedDark ? "emdash-image--light" : undefined },
	...(resolvedDark ? [{ image: resolvedDark, class: "emdash-image--dark" }] : []),
];
---

<figure class:list={["emdash-image", alignment && `emdash-image--align-${alignment}`]}>
	{
		linkHref ? (
			<a href={linkHref} target={linkTarget} rel={linkRel}>
				{variants.map((variant) =>
					variant.image.astroImageSrc ? (
						<AstroImage
							src={variant.image.astroImageSrc}
							alt={alt}
							title={title}
							width={variant.image.renderWidth}
							height={variant.image.renderHeight}
							layout="constrained"
							loading="lazy"
							decoding="async"
							class={variant.class}
							style={variant.image.placeholderStyle || undefined}
						/>
					) : (
						<img
							src={variant.image.src}
							srcset={variant.image.srcset}
							sizes={variant.image.sizes}
							alt={alt}
							title={title}
							width={variant.image.renderWidth}
							height={variant.image.renderHeight}
							loading="lazy"
							decoding="async"
							class={variant.class}
							style={variant.image.placeholderStyle || undefined}
						/>
					),
				)}
			</a>
		) : (
			variants.map((variant) =>
				variant.image.astroImageSrc ? (
					<AstroImage
						src={variant.image.astroImageSrc}
						alt={alt}
						title={title}
						width={variant.image.renderWidth}
						height={variant.image.renderHeight}
						layout="constrained"
						loading="lazy"
						decoding="async"
						class={variant.class}
						style={variant.image.placeholderStyle || undefined}
					/>
				) : (
					<img
						src={variant.image.src}
						srcset={variant.image.srcset}
						sizes={variant.image.sizes}
						alt={alt}
						title={title}
						width={variant.image.renderWidth}
						height={variant.image.renderHeight}
						loading="lazy"
						decoding="async"
						class={variant.class}
						style={variant.image.placeholderStyle || undefined}
					/>
				),
			)
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.emdash-image {
		margin: 1.5rem 0;
	}
	.emdash-image img {
		max-width: 100%;
		height: auto;
	}
	.emdash-image figcaption {
		font-size: 0.875rem;
		color: var(--emdash-caption-color, var(--color-muted, #666));
		margin-top: 0.5rem;
		text-align: center;
	}
	/* Alignment (WordPress-style). Floats wrap surrounding text; wide/full span the column. */
	.emdash-image--align-left,
	.emdash-image--align-right {
		width: fit-content;
		max-width: 50%;
	}
	.emdash-image--align-left {
		float: left;
		margin: 0 1.5rem 1rem 0;
	}
	.emdash-image--align-right {
		float: right;
		margin: 0 0 1rem 1.5rem;
	}
	.emdash-image--align-center {
		width: fit-content;
		margin-inline: auto;
	}
	.emdash-image--align-wide,
	.emdash-image--align-full {
		width: 100%;
	}
	/* On narrow screens, un-float left/right so the image is not cramped beside text. */
	@media (max-width: 640px) {
		.emdash-image--align-left,
		.emdash-image--align-right {
			float: none;
			width: 100%;
			max-width: 100%;
			margin-inline: 0;
		}
	}
</style>

<style is:global>
	/* Same rules as EmDashImage, which a page with only Portable Text images never loads. */
	:where(:root.dark) .emdash-image--light {
		display: none;
	}
	:where(:root.light) .emdash-image--dark {
		display: none;
	}
	@media (prefers-color-scheme: dark) {
		:where(:root:not(.light)) .emdash-image--light {
			display: none;
		}
	}
	@media (prefers-color-scheme: light) {
		:where(:root:not(.dark)) .emdash-image--dark {
			display: none;
		}
	}
</style>
